diff --git a/scripts/train_sst.py b/scripts/train_sst.py
new file mode 100644
--- /dev/null
+++ b/scripts/train_sst.py
@@ -0,0 +1,22 @@
+import json
+
+import numpy as np
+
+from geostack.metrics import rmse
+
+LR = 0.003
+EPOCHS = 40
+
+
+def main():
+    data = np.load("data/processed/sst.npy")
+    data = (data - data.mean()) / data.std()
+    index = np.random.permutation(len(data))
+    train, test = data[index[:800]], data[index[800:]]
+    weights = np.zeros(train.shape[1])
+    for _ in range(EPOCHS):
+        weights -= LR * train.T @ (train @ weights - train[:, 0])
+    with open("outputs/sst_rmse.json", "w") as f:
+        json.dump({"rmse": rmse(test @ weights, test[:, 0]), "history": [1.0, 0.5]}, f)
+
+
+main()
